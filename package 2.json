{
  "name": "spin-doctor",
  "version": "0.1.0",
  "private": true,
  "description": "A satirical mobile-first idle game: spin every scandal for the power-hungry president of the fictional Republic of Superbia.",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter @spin-doctor/client --filter @spin-doctor/server dev",
    "build": "pnpm -r build",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "validate:content": "pnpm --filter @spin-doctor/shared validate:content",
    "size": "pnpm --filter @spin-doctor/client size",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@types/node": "^24.0.0",
    "lefthook": "^2.1.14",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  }
}
