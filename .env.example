# Copy to .env and adjust. Never commit .env.

# --- Production (docker-compose.prod.yml) ---
DOMAIN=spin-doctor.example.org
ACME_EMAIL=you@example.org

POSTGRES_USER=spin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=spin

# Used by the server container (host "db" is the compose service)
DATABASE_URL=postgres://spin:change-me@db:5432/spin
CORS_ORIGIN=https://spin-doctor.example.org
